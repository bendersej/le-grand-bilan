{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "politicians": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "full_name": {
            "type": "string",
            "minLength": 1
          },
          "party": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "mandates": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "object",
                  "properties": {
                    "fr": {
                      "type": "string",
                      "minLength": 1
                    },
                    "en": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "fr",
                    "en"
                  ],
                  "additionalProperties": false
                },
                "from": {
                  "type": "string",
                  "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                },
                "to": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "role",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "profile": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "content_hash": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "photo": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\/media\\/politicians\\/[a-z0-9-]+\\.[a-z0-9]+$"
                      },
                      "source_url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "license": {
                        "type": "string",
                        "minLength": 1
                      },
                      "author": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "path",
                      "source_url",
                      "license",
                      "author"
                    ],
                    "additionalProperties": false
                  },
                  "retrieved_at": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
                  },
                  "summary": {
                    "type": "object",
                    "properties": {
                      "fr": {
                        "type": "string",
                        "minLength": 1
                      },
                      "en": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "fr",
                      "en"
                    ],
                    "additionalProperties": false
                  },
                  "wikipedia_url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "content_hash",
                  "photo",
                  "retrieved_at",
                  "summary",
                  "wikipedia_url"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "full_name",
          "party",
          "mandates",
          "profile"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "politicians"
  ],
  "additionalProperties": false
}
