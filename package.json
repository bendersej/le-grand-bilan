{
  "name": "le-grand-bilan",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "archive:appearances": "node scripts/archive-appearances.ts",
    "build": "vite build",
    "capture:profiles": "node scripts/capture-politician-profiles.ts",
    "cf-typegen": "wrangler types",
    "check": "pnpm run generate-routes && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-routes": "tsr generate",
    "generate:json-schemas": "node scripts/generate-json-schemas.ts",
    "lint": "oxlint",
    "preview": "pnpm run build && vite preview",
    "smoketest": "node scripts/smoketest.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:sources": "node scripts/verify-sources.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.48",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/router-cli": "^1.167.32",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0"
}
