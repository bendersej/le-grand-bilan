{
  "name": "le-grand-bilan",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "check": "pnpm run generate-routes && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite dev --port 3000",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate-routes": "tsr generate",
    "generate:json-schemas": "node scripts/generate-json-schemas.ts",
    "lint": "oxlint",
    "preview": "pnpm run build && vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.124.0"
  },
  "packageManager": "pnpm@11.22.0"
}
